{
  "name": "multi-agent-chat",
  "displayName": "Multi-Agent Chat",
  "description": "Embedded Multi-Agent Chat & CLI terminal in VS Code Secondary Side Bar (OMP Code, OpenCode, Hermes, Cline, etc.)",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:multiAgentChat.terminalView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multi-agent-chat-container",
          "title": "Multi-Agent Chat",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "multi-agent-chat-container": [
        {
          "type": "webview",
          "id": "multiAgentChat.terminalView",
          "name": "Multi-Agent Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "multiAgentChat.openTerminal",
        "title": "Multi-Agent Chat: Focus Terminal"
      },
      {
        "command": "multiAgentChat.addAgent",
        "title": "Multi-Agent Chat: Add New Agent",
        "icon": "$(add)"
      },
      {
        "command": "multiAgentChat.switchHarness",
        "title": "Multi-Agent Chat: Switch Agent",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "multiAgentChat.restartTerminal",
        "title": "Multi-Agent Chat: Restart Session",
        "icon": "$(refresh)"
      },
      {
        "command": "multiAgentChat.killTerminal",
        "title": "Multi-Agent Chat: Kill Session",
        "icon": "$(stop-circle)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiAgentChat.addAgent",
          "when": "view == multiAgentChat.terminalView",
          "group": "navigation@0"
        },
        {
          "command": "multiAgentChat.switchHarness",
          "when": "view == multiAgentChat.terminalView",
          "group": "navigation@1"
        },
        {
          "command": "multiAgentChat.restartTerminal",
          "when": "view == multiAgentChat.terminalView",
          "group": "navigation@2"
        },
        {
          "command": "multiAgentChat.killTerminal",
          "when": "view == multiAgentChat.terminalView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Multi-Agent Chat",
      "properties": {
        "multiAgentChat.harness": {
          "type": "string",
          "default": "omp",
          "description": "Active AI Agent ID (e.g. omp, opencode, hermes, cline, or custom agent)"
        },
        "multiAgentChat.customAgents": {
          "type": "array",
          "default": [],
          "description": "Custom registered AI CLI Agents",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            },
            "required": ["id", "name", "command"]
          }
        },
        "multiAgentChat.harnesses": {
          "type": "object",
          "default": {
            "omp": { "path": "" },
            "opencode": { "path": "" },
            "hermes": { "path": "" },
            "cline": { "path": "" }
          },
          "description": "Custom binary paths for each harness/agent"
        },
        "multiAgentChat.fontSize": {
          "type": "number",
          "default": 13,
          "description": "Terminal font size in pixels"
        },
        "multiAgentChat.fontFamily": {
          "type": "string",
          "default": "Consolas, 'Courier New', monospace",
          "description": "Terminal font family"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node scripts/build-webview.js",
    "watch:webview": "node scripts/build-webview.js --watch",
    "package": "npm run build:webview && tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.0.2"
  }
}
