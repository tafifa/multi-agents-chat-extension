{
  "name": "cli-agents",
  "displayName": "CLI Agents",
  "description": "Embedded AI CLI Agents terminal in VS Code Secondary Side Bar (OMP Code, OpenCode, etc.)",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:cliAgents.terminalView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cli-agents-container",
          "title": "CLI Agents",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "cli-agents-container": [
        {
          "type": "webview",
          "id": "cliAgents.terminalView",
          "name": "CLI Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "cliAgents.openTerminal",
        "title": "CLI Agents: Focus Terminal"
      },
      {
        "command": "cliAgents.switchHarness",
        "title": "CLI Agents: Switch Harness (OMP / OpenCode)",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "cliAgents.restartTerminal",
        "title": "CLI Agents: Restart Session",
        "icon": "$(refresh)"
      },
      {
        "command": "cliAgents.killTerminal",
        "title": "CLI Agents: Kill Session",
        "icon": "$(stop-circle)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cliAgents.switchHarness",
          "when": "view == cliAgents.terminalView",
          "group": "navigation@0"
        },
        {
          "command": "cliAgents.restartTerminal",
          "when": "view == cliAgents.terminalView",
          "group": "navigation@1"
        },
        {
          "command": "cliAgents.killTerminal",
          "when": "view == cliAgents.terminalView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "CLI Agents",
      "properties": {
        "cliAgents.harness": {
          "type": "string",
          "enum": ["omp", "opencode"],
          "enumDescriptions": [
            "OhMyPi Agent CLI (Default)",
            "OpenCode AI Terminal Agent"
          ],
          "default": "omp",
          "description": "Active AI Agent CLI harness"
        },
        "cliAgents.harnesses": {
          "type": "object",
          "default": {
            "omp": { "path": "" },
            "opencode": { "path": "" }
          },
          "description": "Custom binary paths for each harness"
        },
        "cliAgents.fontSize": {
          "type": "number",
          "default": 13,
          "description": "Terminal font size in pixels"
        },
        "cliAgents.fontFamily": {
          "type": "string",
          "default": "Consolas, 'Courier New', monospace",
          "description": "Terminal font family"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node scripts/build-webview.js",
    "watch:webview": "node scripts/build-webview.js --watch",
    "package": "npm run build:webview && tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.0.2"
  }
}
